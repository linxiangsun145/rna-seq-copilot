<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RNA-seq Scientific Report</title>
  <style>
    :root {
      --bg: #f3f6fb;
      --card: #ffffff;
      --line: #dbe4f0;
      --text: #132035;
      --muted: #5c6f8a;
      --blue: #0f4bb8;
      --green: #127c47;
      --yellow-bg: #fff8dd;
      --yellow-text: #8a6400;
      --yellow-line: #f1d35c;
      --red-bg: #fff1f2;
      --red-text: #9f1239;
      --red-line: #fda4af;
      --ok-bg: #ecfdf3;
      --ok-text: #166534;
      --ok-line: #86efac;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
      color: var(--text);
      background: linear-gradient(180deg, #f7f9fd 0%, #eef3fa 100%);
      line-height: 1.55;
    }
    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 28px 20px 60px;
    }
    .header {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 22px 24px;
      margin-bottom: 18px;
    }
    .title {
      margin: 0;
      font-size: 28px;
      color: #0e2b58;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
    .sub {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }
    .section {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 16px;
    }
    .section h2 {
      margin: 0 0 12px;
      font-size: 20px;
      color: #112f5b;
      border-bottom: 1px solid #e5ecf6;
      padding-bottom: 8px;
    }
    .section h3 {
      margin: 12px 0 8px;
      font-size: 15px;
      color: #1a3a67;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }
    .card {
      border: 1px solid #e4ebf4;
      border-radius: 12px;
      padding: 12px;
      background: #fcfdff;
    }
    .card-label {
      font-size: 11px;
      color: #6c7f99;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 4px;
    }
    .card-value {
      font-size: 20px;
      font-weight: 700;
      color: #0f2d56;
      word-break: break-word;
    }
    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      border: 1px solid #d8e3f2;
      background: #f4f8ff;
      color: #1e3a65;
      margin: 2px 4px 2px 0;
    }
    .tag-canonical {
      background: #eef4ff;
      border-color: #98b7f6;
      color: #1e40af;
    }
    .tag-housekeeping {
      background: #fef9ec;
      border-color: #f8da84;
      color: #9a6a00;
    }
    .tag-direction-up {
      background: #fff1f2;
      border-color: #fda4af;
      color: #9f1239;
    }
    .tag-direction-down {
      background: #eff6ff;
      border-color: #93c5fd;
      color: #1d4ed8;
    }
    .tag-direction-neutral {
      background: #f3f4f6;
      border-color: #d1d5db;
      color: #4b5563;
    }
    .badge {
      display: inline-block;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      margin-left: 8px;
      text-transform: uppercase;
      vertical-align: middle;
      letter-spacing: 0.4px;
    }
    .badge-ok { background: var(--ok-bg); color: var(--ok-text); border: 1px solid var(--ok-line); }
    .badge-warning { background: var(--yellow-bg); color: var(--yellow-text); border: 1px solid var(--yellow-line); }
    .badge-critical { background: var(--red-bg); color: var(--red-text); border: 1px solid var(--red-line); }

    .box {
      border-radius: 10px;
      border: 1px solid #e4ebf4;
      background: #fbfdff;
      padding: 12px;
      margin-bottom: 10px;
    }
    .box-critical { background: var(--red-bg); border-color: var(--red-line); color: var(--red-text); }
    .box-warning { background: var(--yellow-bg); border-color: var(--yellow-line); color: var(--yellow-text); }
    .box-ok { background: var(--ok-bg); border-color: var(--ok-line); color: var(--ok-text); }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 14px;
    }
    .plot-card {
      border: 1px solid #dfe9f7;
      border-radius: 12px;
      background: #fff;
      overflow: hidden;
    }
    .plot-title {
      font-size: 13px;
      color: #21406f;
      border-bottom: 1px solid #e5ecf6;
      padding: 8px 10px;
      font-weight: 600;
    }
    .plot-card img {
      width: 100%;
      display: block;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th, td {
      border-bottom: 1px solid #e6edf8;
      padding: 8px;
      text-align: left;
      vertical-align: top;
    }
    th {
      color: #35527f;
      font-weight: 700;
      background: #f8fbff;
    }
    .muted { color: var(--muted); }
    .mono { font-family: Consolas, Menlo, monospace; }
    .legend-list li { margin-bottom: 6px; }
    .row-warning-link { background: #fffdf2; }
    .footer {
      margin-top: 18px;
      text-align: center;
      font-size: 12px;
      color: #7386a1;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1 class="title">RNA-seq Analysis Supplement Report</h1>
      <div class="sub">Generated: {{ generated_at }} | Job: <span class="mono">{{ job_id }}</span></div>
    </div>

    <div class="section">
      <h2>1. Summary Cards</h2>
      <div class="cards">
        <div class="card">
          <div class="card-label">Number of Samples</div>
          <div class="card-value">{{ summary.n_samples }}</div>
        </div>
        <div class="card">
          <div class="card-label">Groups</div>
          <div class="card-value" style="font-size: 14px; font-weight: 600;">
            {% if summary.groups and summary.groups|length > 0 %}
              {{ summary.groups | join(', ') }}
            {% else %}
              not provided
            {% endif %}
          </div>
        </div>
        <div class="card">
          <div class="card-label">DEGs (Up / Down)</div>
          <div class="card-value">{{ summary.deg_up }} / {{ summary.deg_down }}</div>
        </div>
        <div class="card">
          <div class="card-label">PCA Separation</div>
          <div class="card-value" style="text-transform: capitalize;">{{ summary.pca_separation }}</div>
        </div>
        <div class="card">
          <div class="card-label">QC Status</div>
          <div class="card-value" style="text-transform: capitalize;">{{ analysis_status.qc_status if analysis_status else 'warning' }}</div>
        </div>
        <div class="card">
          <div class="card-label">DEG Status</div>
          <div class="card-value" style="text-transform: capitalize;">{{ deg_status if deg_status else 'no_signal' }}</div>
        </div>
        <div class="card">
          <div class="card-label">Realism Status</div>
          <div class="card-value" style="text-transform: capitalize;">{{ analysis_status.realism_status if analysis_status else 'unstable' }}</div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Executive Summary</h2>
      <div class="box">{{ executive_summary }}</div>
    </div>

    <div class="section">
      <h2>2. Overall Assessment</h2>
      <div class="grid-2">
        <div class="box {% if overall_data_quality == 'high' %}box-critical{% elif overall_data_quality == 'moderate' %}box-warning{% else %}box-ok{% endif %}">
          <strong>Data Quality Risk:</strong> {{ overall_data_quality }}
        </div>
        <div class="box {% if overall_realism == 'HIGH' %}box-critical{% elif overall_realism == 'MEDIUM' %}box-warning{% else %}box-ok{% endif %}">
          <strong>Data Realism Suspicion:</strong> {{ overall_realism }}
        </div>
        <div class="box {% if confidence_assessment and confidence_assessment.confidence_level == 'LOW' %}box-critical{% elif confidence_assessment and confidence_assessment.confidence_level == 'MEDIUM' %}box-warning{% else %}box-ok{% endif %}">
          <strong>Analysis Confidence:</strong>
          {% if confidence_assessment %}
            {{ confidence_assessment.confidence_score }}/100 ({{ confidence_assessment.confidence_level }})
          {% else %}
            not available
          {% endif %}
        </div>
      </div>
      <h3>Confidence Breakdown</h3>
      <div class="box">
        {% if confidence_section and confidence_section.breakdown and confidence_section.breakdown|length > 0 %}
          <ul>
            {% for item in confidence_section.breakdown %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <span class="muted">No confidence breakdown available.</span>
        {% endif %}

        {% if confidence_section and confidence_section.penalty_explanations %}
          {% set order = confidence_section.ordered_categories if confidence_section.ordered_categories else ['qc', 'design', 'realism'] %}
          {% for key in order %}
            {% set items = confidence_section.penalty_explanations.get(key, []) %}
            {% if items and items|length > 0 %}
              <h4>{{ key|upper }} Causes</h4>
              <ul>
                {% for reason in items %}
                  <li>{{ reason }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if confidence_section and confidence_section.explanation %}
          <div class="box {% if confidence_section.level == 'LOW' %}box-critical{% elif confidence_section.level == 'MEDIUM' %}box-warning{% else %}box-ok{% endif %}">
            {{ confidence_section.explanation }}
          </div>
        {% endif %}
      </div>
      <h3>Assessment Basis</h3>
      <div class="box">
        {% if assessment_basis_grouped and assessment_basis_grouped|length > 0 %}
          {% set section_order = ['QC - Group-level', 'QC - Design', 'QC - Diagnostic', 'Realism'] %}
          {% for section in section_order %}
            {% if assessment_basis_grouped.get(section) and assessment_basis_grouped.get(section)|length > 0 %}
              <h4>{{ section }}</h4>
              <ul>
                {% for item in assessment_basis_grouped.get(section) %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          {% endfor %}
        {% elif assessment_basis and assessment_basis|length > 0 %}
          <ul>
            {% for item in assessment_basis %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <span class="muted">No major quality or realism concerns detected.</span>
        {% endif %}
      </div>
    </div>

    <div class="section">
      <h2>3. Data Quality (QC)</h2>
      <div class="grid-2">
        {% if plots.pca %}
        <div class="plot-card">
          <div class="plot-title">PCA Plot{% if qc and qc.pca_variance %}<span class="muted"> (PC1 {{ '%.2f'|format(100*qc.pca_variance.PC1) }}%, PC2 {{ '%.2f'|format(100*qc.pca_variance.PC2) }}%)</span>{% endif %}</div>
          <img src="data:image/png;base64,{{ plots.pca }}" alt="PCA" />
        </div>
        {% endif %}
        {% if plots.sample_distance_heatmap %}
        <div class="plot-card">
          <div class="plot-title">Sample Distance Heatmap</div>
          <img src="data:image/png;base64,{{ plots.sample_distance_heatmap }}" alt="Sample distance heatmap" />
        </div>
        {% endif %}
        {% if plots.sample_correlation_heatmap %}
        <div class="plot-card">
          <div class="plot-title">Sample Correlation Heatmap</div>
          <img src="data:image/png;base64,{{ plots.sample_correlation_heatmap }}" alt="Sample correlation heatmap" />
        </div>
        {% endif %}
        {% if plots.library_size %}
        <div class="plot-card">
          <div class="plot-title">Library Size Plot</div>
          <img src="data:image/png;base64,{{ plots.library_size }}" alt="Library size" />
        </div>
        {% endif %}
        {% if plots.count_distribution %}
        <div class="plot-card">
          <div class="plot-title">Count Distribution Plot</div>
          <img src="data:image/png;base64,{{ plots.count_distribution }}" alt="Count distribution" />
        </div>
        {% endif %}
        {% if plots.zero_fraction %}
        <div class="plot-card">
          <div class="plot-title">Zero Fraction Plot</div>
          <img src="data:image/png;base64,{{ plots.zero_fraction }}" alt="Zero fraction" />
        </div>
        {% endif %}
      </div>

      {% if qc_metrics_summary and qc_metrics_summary|length > 0 %}
      <h3>QC Metrics Summary</h3>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>Value</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {% for row in qc_metrics_summary %}
          <tr {% if row.linked_warning %}class="row-warning-link"{% endif %}>
            <td>{{ row.name }}</td>
            <td>{{ row.value }}</td>
            <td>
              <span class="badge {% if row.status == 'CRITICAL' %}badge-critical{% elif row.status == 'WARNING' %}badge-warning{% else %}badge-ok{% endif %}">{{ row.status }}</span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <h3>QC Metrics</h3>
      <div class="cards">
        <div class="card">
          <div class="card-label">Replicates per Group</div>
          <div class="card-value" style="font-size: 13px; font-weight: 600;">
            {% if qc and qc.replicates_per_group and qc.replicates_per_group|length > 0 %}
              {% for k, v in qc.replicates_per_group.items() %}<span class="tag">{{ k }}: {{ v }}</span>{% endfor %}
            {% else %}
              no issues detected
            {% endif %}
          </div>
        </div>
        <div class="card">
          <div class="card-label">Group Balance Ratio</div>
          <div class="card-value">{% if qc and qc.group_balance %}{{ '%.3f'|format(qc.group_balance.ratio) }}{% else %}not available{% endif %}</div>
        </div>
        <div class="card">
          <div class="card-label">Detected Outliers</div>
          <div class="card-value" style="font-size: 13px; font-weight: 600;">
            {% if qc and qc.outliers and qc.outliers|length > 0 %}
              {% for s in qc.outliers %}<span class="tag">{{ s }}</span>{% endfor %}
            {% else %}
              no issues detected
            {% endif %}
          </div>
        </div>
        <div class="card">
          <div class="card-label">Low-quality Samples</div>
          <div class="card-value" style="font-size: 13px; font-weight: 600;">
            {% if qc and qc.low_quality_samples and qc.low_quality_samples|length > 0 %}
              {% for s in qc.low_quality_samples %}<span class="tag">{{ s }}</span>{% endfor %}
            {% else %}
              no issues detected
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>4. QC Warnings (Severity)</h2>
      <div class="box {% if qc_status == 'critical' %}box-critical{% elif qc_status == 'warning' %}box-warning{% else %}box-ok{% endif %}">
        {{ qc_section_text }}
      </div>
      {% if qc and qc.qc_warnings and qc.qc_warnings|length > 0 %}
        {% for item in qc.qc_warnings %}
          <div class="box box-warning">{{ item }}</div>
        {% endfor %}
      {% else %}
        <div class="box box-ok">No QC warning text reported.</div>
      {% endif %}
    </div>

    <div class="section">
      <h2>5. DEG Summary</h2>
      <div class="cards">
        <div class="card"><div class="card-label">Upregulated genes</div><div class="card-value">{{ summary.deg_up }}</div></div>
        <div class="card"><div class="card-label">Downregulated genes</div><div class="card-value">{{ summary.deg_down }}</div></div>
        <div class="card"><div class="card-label">DEG status</div><div class="card-value" style="text-transform: capitalize; font-size: 16px;">{{ deg_status if deg_status else 'no_signal' }}</div></div>
        <div class="card"><div class="card-label">Near-significant genes</div><div class="card-value">{{ summary.near_sig_genes if summary.near_sig_genes is not none else 0 }}</div></div>
        <div class="card"><div class="card-label">Threshold</div><div class="card-value" style="font-size: 13px;">{{ analysis_methods.deg_threshold }}</div></div>
      </div>

      {% if deg_status == 'low_effect_size' %}
      <div class="box box-warning">
        Several genes showed statistically significant changes but did not meet the fold-change threshold.
      </div>
      {% endif %}

      {% if deg_status == 'low_power' and exploratory_deg_candidates and exploratory_deg_candidates|length > 0 %}
      <h3>Exploratory Low-confidence DEG Candidates</h3>
      <div class="box box-warning">
        No significant DEGs were detected under primary thresholds. The candidates below are exploratory and hypothesis-generating.
      </div>
      <table>
        <thead>
          <tr>
            <th>Gene</th>
            <th>log2FC</th>
            <th>padj</th>
            <th>p-value</th>
            <th>Rank score</th>
            <th>Label</th>
          </tr>
        </thead>
        <tbody>
          {% for c in exploratory_deg_candidates %}
          <tr>
            <td class="mono">{{ c.gene }}</td>
            <td>{{ '%.3f'|format(c.log2fc) }}</td>
            <td>{{ '%.2e'|format(c.padj) }}</td>
            <td>{{ '%.2e'|format(c.pvalue) }}</td>
            <td>{{ '%.3f'|format(c.rank_score) }}</td>
            <td>{{ c.label }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>

    <div class="section">
      <h2>6. Top Genes (Top 20)</h2>
      {% if top_genes_display and top_genes_display|length > 0 %}
      <table>
        <thead>
          <tr>
            <th>Gene</th>
            <th>log2FoldChange</th>
            <th>adjusted p-value</th>
            <th>Direction</th>
            <th>Biotype</th>
            <th>Tags</th>
          </tr>
        </thead>
        <tbody>
          {% for row in top_genes_display %}
          <tr>
            <td class="mono">{{ row.gene }}</td>
            <td>{{ row.log2fc }}</td>
            <td>{{ row.padj }}</td>
            <td>
              <span class="tag {% if row.direction == 'Up' %}tag-direction-up{% elif row.direction == 'Down' %}tag-direction-down{% else %}tag-direction-neutral{% endif %}">{{ row.direction }}</span>
            </td>
            <td>
              <span class="tag">{{ row.biotype if row.biotype else 'unknown' }}</span>
            </td>
            <td>
              {% if row.tags and row.tags|length > 0 %}
                {% for tag in row.tags %}
                  {% if tag == 'canonical' %}<span class="tag tag-canonical">canonical</span>{% elif tag == 'housekeeping' %}<span class="tag tag-housekeeping">housekeeping</span>{% else %}<span class="tag">{{ tag }}</span>{% endif %}
                {% endfor %}
              {% else %}
                <span class="muted">None</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="box box-ok">No significant genes detected.</div>
      {% endif %}
    </div>

    <div class="section">
      <h2>7. Figures</h2>
      <div class="grid-2">
        {% if plots.volcano %}
        <div class="plot-card"><div class="plot-title">Volcano Plot</div><img src="data:image/png;base64,{{ plots.volcano }}" alt="Volcano" /></div>
        {% endif %}
        {% if plots.ma %}
        <div class="plot-card"><div class="plot-title">MA Plot</div><img src="data:image/png;base64,{{ plots.ma }}" alt="MA" /></div>
        {% endif %}
        {% if plots.pca %}
        <div class="plot-card"><div class="plot-title">PCA Plot</div><img src="data:image/png;base64,{{ plots.pca }}" alt="PCA" /></div>
        {% endif %}
      </div>
    </div>

    <div class="section">
      <h2>8. Data Realism / Validation</h2>
      <div class="box {% if realism_status == 'high' %}box-critical{% elif realism_status == 'low' %}box-ok{% else %}box-warning{% endif %}">
        {{ realism_section_text }}
      </div>
    </div>

    <div class="section">
      <h2>9. Warnings Grouped by Type</h2>
      <h3>QC</h3>
      {% if warning_groups and warning_groups.qc and warning_groups.qc|length > 0 %}
        {% for item in warning_groups.qc %}
          <div class="box {% if item.level == 'critical' %}box-critical{% else %}box-warning{% endif %}">{{ item.message }}{% if item.evidence %} ({{ item.evidence }}){% endif %}</div>
        {% endfor %}
      {% else %}
        <div class="box box-ok">No issues detected.</div>
      {% endif %}

      <h3>Realism</h3>
      {% if warning_groups and warning_groups.realism and warning_groups.realism|length > 0 %}
        {% for item in warning_groups.realism %}
          <div class="box {% if item.level == 'critical' %}box-critical{% else %}box-warning{% endif %}">{{ item.message }}{% if item.evidence %} ({{ item.evidence }}){% endif %}</div>
        {% endfor %}
      {% else %}
        <div class="box box-ok">No issues detected.</div>
      {% endif %}

      <h3>Statistical</h3>
      {% if warning_groups and warning_groups.statistical and warning_groups.statistical|length > 0 %}
        {% for item in warning_groups.statistical %}
          <div class="box box-warning">{{ item.message }}{% if item.evidence %} ({{ item.evidence }}){% endif %}</div>
        {% endfor %}
      {% else %}
        <div class="box box-ok">No issues detected.</div>
      {% endif %}
    </div>

    <div class="section">
      <h2>10. AI Interpretation</h2>
      <div class="box {% if interpretation_confidence.level == 'LOW' %}box-critical{% elif interpretation_confidence.level == 'MEDIUM' %}box-warning{% else %}box-ok{% endif %}">
        <strong>Interpretation Confidence:</strong>
        <span class="badge {% if interpretation_confidence.level == 'LOW' %}badge-critical{% elif interpretation_confidence.level == 'MEDIUM' %}badge-warning{% else %}badge-ok{% endif %}">{{ interpretation_confidence.level }}</span>
      </div>

      <h3>Justification</h3>
      {% if interpretation_confidence and interpretation_confidence.reasons and interpretation_confidence.reasons|length > 0 %}
        <ul>
          {% for reason in interpretation_confidence.reasons %}
            <li>{{ reason }}</li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="box box-ok">No major technical limitations detected.</div>
      {% endif %}

      {% if llm %}
        <div class="box"><strong>PCA interpretation:</strong><br />{{ llm.pca_text }}</div>
        <div class="box"><strong>DEG summary:</strong><br />{{ llm.deg_summary }}</div>
        <div class="box"><strong>Biological insight:</strong><br />{{ llm.biological_insights }}</div>
        <div class="box"><strong>Limitations:</strong><br />{{ interpretation_limitation_text }}{% if llm.data_quality %} {{ llm.data_quality }}{% endif %}</div>
        <div class="box"><strong>Recommendations:</strong><br />{{ llm.next_steps }}</div>
      {% else %}
        <div class="box box-warning">AI interpretation is unavailable for this run. {{ interpretation_limitation_text }}</div>
      {% endif %}
    </div>

    <div class="section">
      <h2>ncRNA Findings</h2>
      {% if ncrna_section and ncrna_section.summary_metrics %}
      <div class="cards">
        <div class="card"><div class="card-label">Total DEGs</div><div class="card-value">{{ ncrna_section.summary_metrics.n_total_deg }}</div></div>
        <div class="card"><div class="card-label">ncRNA DEGs</div><div class="card-value">{{ ncrna_section.summary_metrics.n_ncrna_deg }}</div></div>
        <div class="card"><div class="card-label">lncRNA DEGs</div><div class="card-value">{{ ncrna_section.summary_metrics.n_lncRNA_deg }}</div></div>
        <div class="card"><div class="card-label">miRNA DEGs</div><div class="card-value">{{ ncrna_section.summary_metrics.n_miRNA_deg }}</div></div>
      </div>

      {% if ncrna_section.narrative and ncrna_section.narrative|length > 0 %}
      <div class="box">
        <ul>
          {% for line in ncrna_section.narrative %}
          <li>{{ line }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <h3>ncRNA Diagnostics</h3>
      <div class="box">
        {% if sparse_ncrna_metrics %}
        <div><strong>Global zero fraction:</strong> {{ '%.3f'|format(sparse_ncrna_metrics.zero_fraction_global or 0) }}</div>
        <div><strong>ncRNA dataset label:</strong> {{ sparse_ncrna_metrics.dataset_label or 'ncRNA-rich dataset' }}</div>
        {% endif %}
        <div><strong>ncRNA zero fraction:</strong> {{ '%.3f'|format(ncrna_section.qc_metrics.ncrna_zero_fraction or 0) }}</div>
        <div><strong>ncRNA low-count fraction:</strong> {{ '%.3f'|format(ncrna_section.qc_metrics.ncrna_low_count_fraction or 0) }}</div>
        <div><strong>miRNA detected count:</strong> {{ ncrna_section.qc_metrics.miRNA_detected_count or 0 }}</div>
        <div><strong>lncRNA detected count:</strong> {{ ncrna_section.qc_metrics.lncRNA_detected_count or 0 }}</div>
      </div>

      <h3>ncRNA Warnings</h3>
      {% if ncrna_section.warnings and ncrna_section.warnings|length > 0 %}
        {% for w in ncrna_section.warnings %}
          <div class="box box-warning">{{ w }}</div>
        {% endfor %}
      {% else %}
        <div class="box box-ok">No ncRNA-specific warnings detected.</div>
      {% endif %}

      <h3>Prioritized ncRNA Candidates</h3>
      {% if ncrna_section.top_candidates and ncrna_section.top_candidates|length > 0 %}
      <table>
        <thead>
          <tr>
            <th>Gene</th>
            <th>Biotype</th>
            <th>Priority score</th>
            <th>padj</th>
            <th>|log2FC|</th>
          </tr>
        </thead>
        <tbody>
          {% for c in ncrna_section.top_candidates %}
          <tr>
            <td class="mono">{{ c.gene }}</td>
            <td>{{ c.biotype }}</td>
            <td>{{ '%.3f'|format(c.priority_score) }}</td>
            <td>{{ '%.2e'|format(c.padj) }}</td>
            <td>{{ '%.3f'|format(c.abs_log2fc) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
        <div class="box box-ok">No ncRNA candidates met prioritization criteria.</div>
      {% endif %}
      {% else %}
      <div class="box box-ok">ncRNA assessment is not available for this run.</div>
      {% endif %}
    </div>

    <div class="section">
      <h2>11. Methods (Expanded)</h2>
      <table>
        <tbody>
          <tr><th style="width: 240px;">Design formula</th><td>{{ analysis_methods.design_formula }}</td></tr>
          <tr><th>Contrast</th><td>{{ analysis_methods.contrast }}</td></tr>
          <tr><th>Normalization method</th><td>{{ analysis_methods.normalization_method }}</td></tr>
          <tr><th>Filtering criteria</th><td>{{ analysis_methods.filtering_criteria }}</td></tr>
          <tr><th>Statistical test</th><td>{{ analysis_methods.statistical_test }}</td></tr>
          <tr><th>Multiple testing correction</th><td>{{ analysis_methods.multiple_testing_correction }}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>12. Publication-ready Text</h2>
      <h3>Methods paragraph</h3>
      <div class="box">{{ methods_paragraph }}</div>

      <h3>Results paragraph</h3>
      <div class="box">{{ results_paragraph }}</div>

      <h3>Figure legends</h3>
      <ul class="legend-list">
        {% if figure_legends and figure_legends|length > 0 %}
          {% for lg in figure_legends %}
            <li><strong>{{ lg.title }}:</strong> {{ lg.text }}</li>
          {% endfor %}
        {% else %}
          <li>No issues detected.</li>
        {% endif %}
      </ul>
    </div>

    <div class="footer">RNA-seq report generated from structured JSON outputs only</div>
  </div>
</body>
</html>
